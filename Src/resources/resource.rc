/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_MAIN MENU
BEGIN
    MENUITEM "復元(&R) (Enter)",              IDM_MENU_RESTORE
    MENUITEM "クリア(&C)",                     IDM_MENU_CLEAR
    MENUITEM "編集(&E)",                      IDM_MENU_EDIT
    POPUP "設定(&O)"
    BEGIN
        MENUITEM "再帰的に追加(&S)",                  IDM_MENU_RECURSIVE
        MENUITEM "復元前に確認ダイアログを表示(&R)",          IDM_MENU_CONFIRM_RESTORE
        MENUITEM "クリア前に確認ダイアログを表示(&C)",         IDM_MENU_CONFIRM_CLEAR
        MENUITEM "日付加減算(&A)",                   IDM_MENU_ADD_DATE
    END
END

IDR_MENU_EDIT MENU
BEGIN
    MENUITEM "OK(&O)",                      IDOK
    MENUITEM "キャンセル(&C)",                   IDCANCEL
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_DIALOG_MAIN DIALOGEX 0, 0, 300, 120
STYLE DS_SETFONT | DS_3DLOOK | DS_FIXEDSYS | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_OVERLAPPEDWINDOW | WS_EX_APPWINDOW
CAPTION "TimeStamp Keeper"
MENU IDR_MENU_MAIN
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LIST1,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | LVS_NOSORTHEADER | WS_TABSTOP,0,0,300,120
END

IDD_DIALOG_EDIT DIALOGEX 0, 0, 300, 48
STYLE DS_SETFONT | DS_3DLOOK | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "情報の編集"
MENU IDR_MENU_EDIT
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDIT_FILE,48,5,240,12,ES_AUTOHSCROLL
    CONTROL         "",IDC_DATETIMEPICKER_FILE,"SysDateTimePick32",DTS_RIGHTALIGN | WS_TABSTOP,48,25,112,12
    LTEXT           "ファイル名",IDC_STATIC,10,7,34,9
    LTEXT           "更新日時",IDC_STATIC,10,27,35,9
    LTEXT           "",IDC_STATIC_ADD_DATE,170,27,118,9
END

IDD_DIALOG_ADDDATE DIALOGEX 0, 0, 309, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "日付加減算"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "年数",IDC_STATIC,24,17,17,8
    LTEXT           "月数",IDC_STATIC,104,17,17,8
    LTEXT           "日数",IDC_STATIC,184,17,17,8
    LTEXT           "時間数",IDC_STATIC,16,41,25,8
    LTEXT           "分数",IDC_STATIC,104,41,17,8
    LTEXT           "秒数",IDC_STATIC,184,41,17,8
    COMBOBOX        IDC_COMBO_YEAR,44,15,48,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    COMBOBOX        IDC_COMBO_MONTH,124,15,48,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_DAY,204,15,48,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_HOUR,44,39,48,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_MINUTE,124,39,48,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_SECOND,204,39,48,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,198,66,50,14,WS_GROUP
    PUSHBUTTON      "キャンセル",IDCANCEL,252,66,50,14
END


